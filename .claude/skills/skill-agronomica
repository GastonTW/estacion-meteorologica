## 6. Ejemplo de ciclo de lectura integrado (pseudocódigo Arduino)

```cpp
void loop() {
    LecturaSensores actual;
    actual.temperatura = mediaMovil(leerTemperatura());
    actual.humedad = leerHumedad();
    actual.presion = leerPresion();
    actual.puntoRocio = calcularPuntoRocio(actual.temperatura, actual.humedad);

    actual.tasaEnfriamiento = calcularTasaEnfriamiento(
        tempAlAtardecer, actual.temperatura, horasDesdeAtardecer()
    );

    float tMinimaEstimada = estimarTemperaturaMinima(
        actual.temperatura, actual.tasaEnfriamiento, horasHastaAmanecer()
    );

    int score = calcularIndiceRiesgo(actual, deltaPresion6h());

    actualizarMaquinaEstados(actual, score, tMinimaEstimada);

    delay(intervaloMuestreoActual()); // varía según estado (ver sección 5)
}
```

